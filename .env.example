# Application Settings
APP_NAME=Ataa-Backend
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://yzes95.github.io"]

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ataa_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ataa_db

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 Storage (Documents & Receipts)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=ataa-verification-documents

# Payment Gateway Keys
INSTAPAY_WEBHOOK_SECRET=your-instapay-webhook-secret
FAWRY_MERCHANT_CODE=your-fawry-merchant-code
FAWRY_SECURITY_KEY=your-fawry-security-key
PAYMOB_API_KEY=your-paymob-api-key
